# ==========================================
# Monorepo Root .gitignore
# ==========================================

# Dependencies
/backend/vendor/
/frontend/node_modules/
node_modules/

# Secrets & Environment variables (CRITICAL: Never commit .env)
/backend/.env
/backend/.env.backup
/backend/.env.production
.env

# Laravel Storage & Framework caches
/backend/storage/*.key
/backend/storage/logs/*.log
/backend/storage/framework/cache/data/*
!/backend/storage/framework/cache/data/.gitignore
/backend/storage/framework/sessions/*
!/backend/storage/framework/sessions/.gitignore
/backend/storage/framework/views/*
!/backend/storage/framework/views/.gitignore
/backend/storage/pail/*
/backend/.phpunit.cache/
/backend/.phpunit.result.cache

# Angular build outputs & caches (for future frontend)
/frontend/.angular/
/frontend/dist/
/frontend/.env

# Local database & Docker volumes
postgres_data/

# Operating System & IDE Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
